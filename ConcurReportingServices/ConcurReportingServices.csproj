<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Version>0.5.10</Version>
	  <AssemblyVersion>0.5.10.0</AssemblyVersion>
	  <FileVersion>0.5.10.0</FileVersion>
	  <PackageId>ConcurReportingServices</PackageId>
	  <Authors>David Rogala</Authors>
	  <Description>A .NET 10 client library to retrieve and update Concur Expense reports. Supports Reports, Entries, Itemizations, and Allocations.</Description>
	  <PackageTags>concur;sap;expense;client</PackageTags>
	  <RepositoryUrl>https://gitlab.com/mandtbank/mtb/magellan/dotnet-libraries/concur-reporting/concur-reporting-client</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <Title>Concur Expense Reporting Services</Title>
  </PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="ConcurExpense" Version="0.8.0" />
    <PackageReference Include="ConcurReporting.Domain" Version="0.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
